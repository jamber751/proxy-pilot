#!/bin/zsh -f
set -euo pipefail
export PATH=/usr/bin:/bin:/usr/sbin:/sbin
[[ $EUID == 0 && $UID == 0 && ${3:-} == / ]] || exit 77
PACKAGE_ROOT="${0:A:h}/Payload"
# The builder substitutes one fixed action, never package arguments or IPC.
exec /usr/bin/env -i PATH=/usr/bin:/bin:/usr/sbin:/sbin \
  "$PACKAGE_ROOT/ProxyPilot.app/Contents/MacOS/ProxyPilot" --vpn-support-@ACTION@
