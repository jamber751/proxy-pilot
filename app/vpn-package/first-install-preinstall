#!/bin/zsh -f
set -euo pipefail
export PATH=/usr/bin:/bin:/usr/sbin:/sbin
[[ $EUID == 0 && $UID == 0 && ${3:-} == / ]] || exit 77
PACKAGE_ROOT="${0:A:h}/Payload"
# Verify the independently signed release and prove this is a clean install
# before Installer places the application payload in /Applications.
exec /usr/bin/env -i PATH=/usr/bin:/bin:/usr/sbin:/sbin \
  "$PACKAGE_ROOT/ProxyPilot.app/Contents/MacOS/ProxyPilot" \
  --vpn-support-verify-first-install
