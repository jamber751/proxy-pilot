#!/bin/zsh -f
set -euo pipefail
export PATH=/usr/bin:/bin:/usr/sbin:/sbin
[[ $EUID == 0 && $UID == 0 && ${3:-} == / ]] || exit 77
# Reject unsupported systems before executing payload code or replacing files.
SYSTEM_VERSION=$(/usr/bin/env -i PATH=/usr/bin:/bin:/usr/sbin:/sbin /usr/bin/sw_vers -productVersion) || exit 77
SYSTEM_MAJOR=${SYSTEM_VERSION%%.*}
if [[ $SYSTEM_MAJOR != <-> || ${#SYSTEM_MAJOR} -gt 3 ]]; then
  print -u2 "ProxyPilot requires macOS 12 or later."
  exit 77
fi
if (( 10#$SYSTEM_MAJOR < 12 )); then
  print -u2 "ProxyPilot requires macOS 12 or later."
  exit 77
fi
PACKAGE_ROOT="${0:A:h}/Rescue"
# Verify all package material and safe fixed ancestors before Installer writes
# the payload. An existing different rescue is preserved and rejected.
exec /usr/bin/env -i PATH=/usr/bin:/bin:/usr/sbin:/sbin \
  "$PACKAGE_ROOT/Executable/vpn-rescue" preflight-install "$PACKAGE_ROOT"
